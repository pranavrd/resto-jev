# Data stays out of git. Yelp data and anything derived from it must never be committed (see docs/decisions/0001).
data/*
!data/.gitkeep

# Write-ups that contain numbers or examples from the Yelp Data stay local (decision 0019, agreement 4E)
docs/private/
*.parquet
*.csv.gz
*.dump
*.sql.gz

# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Web viewer
web/node_modules/
web/dist/
web/public/data/
